# Copy the variables you need into your shell environment. Everything has a sensible default.

# Chat model. "ollama" runs locally for free; "openai" works with any OpenAI-compatible API (OpenAI, Groq, Together...).
LLM_PROVIDER=ollama
CHAT_MODEL=qwen2.5:7b
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=...

# Embeddings always come from Ollama.
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# Retrieval: bm25 | vector | hybrid | hybrid+rewrite
RETRIEVAL_MODE=hybrid+rewrite
TOP_K=4

# Leave empty for embedded on-disk Qdrant; set to use a Qdrant server, e.g. http://localhost:6333
QDRANT_URL=
